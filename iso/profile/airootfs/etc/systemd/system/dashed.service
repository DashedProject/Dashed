[Unit]
Description=Dashed Installer
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/bin/bash /usr/local/bin/dashed.sh

StandardInput=tty
StandardOutput=tty
StandardError=tty

TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target